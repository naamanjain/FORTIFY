# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
*.so

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Regenerated FORTIFY data and artifacts ───────────────────────────────────
# Everything below is reproducible from source with `python scripts/build_all.py`
# (~300 MB of generated CSVs, trained models, and demo packages). Only the
# .gitkeep placeholders and the documentation files are tracked.
data/generated/*
!data/generated/.gitkeep
!data/generated/README.md
!data/generated/FEATURE_CATALOG.md
artifacts/*
!artifacts/.gitkeep

# ── Runtime state (SQLite workflow database, audit log) — never commit ────────
data/runtime/
# A second audit chain was briefly written here by an earlier promote_model path.
# The files are kept on disk as evidence of that split, but runtime state must
# never enter the repository - the log and its anchor are as sensitive as the key.
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Local configuration and secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore

# ── Snapshot archives handed around by hand ──────────────────────────────────
# An audit snapshot of this tree was shared as a zip containing node_modules,
# __pycache__, the SQLite workflow database and audit HMAC key material. It is
# an evidence copy, never a source of truth, and must not enter the repository.
AUDIT*.zip
*.audit.zip

# ── Logs, temporary files, OS/editor noise ───────────────────────────────────
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
.idea/
.vscode/
*.screenshot/