# FORTIFY frontend configuration (prototype)
# Copy to frontend/.env.local. Restart the dev server / rebuild after changing.

# Workspace identity sent as X-Fortify-Role on every request (prototype only —
# the backend does not authenticate these headers).
# Roles: WELFARE_OFFICER | COMMANDER | SYSTEM_ADMINISTRATOR | AUDITOR
VITE_FORTIFY_ROLE=WELFARE_OFFICER

# Purpose sent as X-Fortify-Purpose: WELFARE_SUPPORT | AGGREGATE_OPERATIONS | AUDIT | INFRASTRUCTURE_ADMIN
VITE_FORTIFY_PURPOSE=WELFARE_SUPPORT

# Backend base URL. Leave empty for same-origin requests (Vite dev proxy or a
# reverse proxy in deployment). Set explicitly when the API runs on another host,
# e.g. http://localhost:8000
VITE_API_BASE_URL=
