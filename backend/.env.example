# FORTIFY backend configuration (prototype)
# Copy to backend/.env or export in your shell. All values have working defaults.

# SQLite database location. Relative paths resolve against the repository root.
FORTIFY_DATABASE_URL=sqlite:///./backend/fortify.db

# Comma-separated list of allowed browser origins for the API (dev frontend).
FORTIFY_CORS_ORIGINS=http://localhost:5173

# Directory holding the generated demo CSVs (defaults to <repo>/data/generated).
# FORTIFY_DATA_DIR=

# Directory for runtime state such as the workflow SQLite database and the
# JSONL audit log (defaults to <repo>/data/runtime).
# FORTIFY_RUNTIME_DIR=

# Where the JSONL audit log is written (defaults to <repo>/data/runtime/audit.jsonl).
# FORTIFY_AUDIT_LOG=

# Request budget per client per minute on /api/ (application level). Leave
# unset to disable; the container stack also enforces an nginx edge limit.
# FORTIFY_RATE_LIMIT=120

# Structured JSON log level (DEBUG|INFO|WARNING|ERROR). Log records are
# redacted for personnel identifiers and free-text comments.
# FORTIFY_LOG_LEVEL=INFO

# Key used to sign the audit-log anchor (HMAC-SHA256). Minimum 32 bytes.
# In the prototype a key file is generated beside the audit log when this is
# unset; a production deployment must supply this from a secret manager so
# the key is held outside the log directory.
# FORTIFY_AUDIT_HMAC_KEY=

# Override the version reported by /health, /ready and /version.
# FORTIFY_APP_VERSION=0.2.0

# NOTE: there is no authentication in the prototype. The API trusts the
# X-Fortify-Role / X-Fortify-Purpose headers, which the frontend sets from the
# VITE_FORTIFY_ROLE / VITE_FORTIFY_PURPOSE build-time variables. Do not expose
# this prototype to untrusted networks. See SECURITY_MODEL.md.

# --- PostgreSQL production mode (optional) ---
# Install backend/requirements-postgres.txt and point the URL at the server.
# FORTIFY_DATABASE_URL=postgresql://fortify:CHANGE-ME@db-host:5432/fortify
# FORTIFY_PG_POOL_MAX=8

# --- Production authentication (OIDC) ---
# Required when FORTIFY_AUTH_MODE=production; see docs/OIDC_INTEGRATION.md.
# FORTIFY_AUTH_MODE=production
# FORTIFY_OIDC_ISSUER=https://idp.department.example
# FORTIFY_OIDC_AUDIENCE=fortify-api
# FORTIFY_OIDC_JWKS_URI=https://idp.department.example/.well-known/jwks.json
# FORTIFY_OIDC_ROLE_CLAIM=roles
# FORTIFY_OIDC_UNIT_CLAIM=fortify_units
# FORTIFY_OIDC_LEEWAY_SECONDS=30

# --- Object-level (unit) scope for the demonstration build ---
# Applies ONLY to unauthenticated header trust (FORTIFY_AUTH_MODE=demo). A
# verified identity is scoped by its IdP claims and ignores this entirely.
#
# Default (unset): every unit, so the prototype works out of the box.
# To exercise unit scoping, list real unit ids from your dataset:
# FORTIFY_DEMO_UNIT_SCOPE=U-011,U-012
# Empty or malformed value = no person-level access at all (fail closed).
# FORTIFY_DEMO_UNIT_SCOPE=demo:all-units

# --- Ingestion (disabled by default; infrastructure-gated when enabled) ---
# FORTIFY_ENABLE_INGEST=1
