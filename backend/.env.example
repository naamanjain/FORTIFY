# FORTIFY backend configuration (prototype)
# Copy to backend/.env or export in your shell. All values have working defaults.

# SQLite database location. Relative paths resolve against the repository root.
FORTIFY_DATABASE_URL=sqlite:///./backend/fortify.db

# Comma-separated list of allowed browser origins for the API (dev frontend).
FORTIFY_CORS_ORIGINS=http://localhost:5173

# Directory holding the generated demo CSVs (defaults to <repo>/data/generated).
# FORTIFY_DATA_DIR=

# Directory for runtime state such as the workflow SQLite database and the
# JSONL audit log (defaults to <repo>/data/runtime).
# FORTIFY_RUNTIME_DIR=

# Where the JSONL audit log is written (defaults to <repo>/data/runtime/audit.jsonl).
# FORTIFY_AUDIT_LOG=

# NOTE: there is no authentication in the prototype. The API trusts the
# X-Fortify-Role / X-Fortify-Purpose headers, which the frontend sets from the
# VITE_FORTIFY_ROLE / VITE_FORTIFY_PURPOSE build-time variables. Do not expose
# this prototype to untrusted networks. See SECURITY_MODEL.md.
